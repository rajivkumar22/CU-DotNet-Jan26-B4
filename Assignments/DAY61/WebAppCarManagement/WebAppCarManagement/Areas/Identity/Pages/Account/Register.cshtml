@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
}

<style>
    body {
        background: linear-gradient(to right, #43e97b, #38f9d7);
    }

    .register-container {
        height: 100vh;
    }

    .register-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .btn-register {
        background: #28a745;
        border: none;
    }

        .btn-register:hover {
            background: #1e7e34;
        }

    .logo {
        width: 70px;
    }
</style>

<div class="container register-container d-flex justify-content-center align-items-center">
    <div class="col-md-4">
        <div class="register-card">

            <div class="text-center mb-3">
                <img src="~/images/logo.png" class="logo" />
                <h3 class="mt-2 text-dark">Car Management System 🚗</h3>
                <p class="text-muted">Create your account</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label text-dark"></label>
                    <input asp-for="Input.Email" class="form-control" placeholder="Enter email" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label text-dark"></label>
                    <input asp-for="Input.Password" class="form-control" placeholder="Enter password" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label text-dark"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Confirm password" />
                </div>

                <button type="submit" class="btn btn-register w-100 mb-3">Register</button>

                <div class="text-center">
                    <a asp-page="./Login">Already have an account? Login</a>
                </div>
            </form>

        </div>
    </div>
</div>