@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background: linear-gradient(to right, #4facfe, #00f2fe);
    }

    .login-container {
        height: 100vh;
    }

    .login-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    .btn-login {
        background: #007bff;
        border: none;
    }

        .btn-login:hover {
            background: #0056b3;
        }

    .logo {
        width: 70px;
    }
</style>

<div class="container login-container d-flex justify-content-center align-items-center">
    <div class="col-md-4">
        <div class="login-card">

            <div class="text-center mb-3">
                <img src="~/images/logo.png" class="logo" />
                <h3 class="mt-2 text-dark">Car Management System 🚗</h3>
                <p class="text-muted">Login to your account</p>
            </div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label text-dark"></label>
                    <input asp-for="Input.Email" class="form-control" placeholder="Enter email" />
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label text-dark"></label>
                    <input asp-for="Input.Password" class="form-control" placeholder="Enter password" />
                </div>

                <div class="form-check mb-3">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label text-dark"></label>
                </div>

                <button type="submit" class="btn btn-login w-100 mb-3">Login</button>

                <div class="text-center">
                    <a asp-page="./Register">Create Account</a> |
                    <a asp-page="./ForgotPassword">Forgot Password?</a>
                </div>
            </form>

        </div>
    </div>
</div>