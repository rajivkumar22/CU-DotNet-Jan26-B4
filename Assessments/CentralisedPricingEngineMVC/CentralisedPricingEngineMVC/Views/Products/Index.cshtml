<div class="container mt-5">

    <!-- Title -->
    <h2 class="text-center mb-4">🛍️ Product List</h2>

    <!-- Offers Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">🎁 Available Offers</h5>
            <ul class="mb-0">
                <li><b>WINTER25</b> → 15% OFF</li>
                <li><b>FREESHIP</b> → $5 OFF</li>
            </ul>
        </div>
    </div>

    <!-- Promo Form -->
    <form method="get" class="row g-3 mb-4">
        <div class="col-auto">
            <input type="text" class="form-control" name="promocode" placeholder="Enter Promo Code" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Apply</button>
            <a href="@Url.Action("Index", "Products")" class="btn btn-secondary">Reset</a>
        </div>
    </form>

    <!-- Alerts -->
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    @if (ViewBag.IsApplied)
    {
        <div class="alert alert-success">✅ Promo Code Applied!</div>
    }

    <!-- Product Table -->
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Original Price</th>

                        @if (ViewBag.IsApplied)
                        {
                            <th>Discounted Price</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in ViewBag.Products)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>₹@item.OriginalPrice</td>

                            @if (ViewBag.IsApplied)
                            {
                                <td class="text-success fw-bold">₹@item.DiscountedPrice</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>