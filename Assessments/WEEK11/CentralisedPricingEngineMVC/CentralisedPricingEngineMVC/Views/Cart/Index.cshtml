<div class="container mt-5">
    <h2 class="text-center mb-4">🛒 Shopping Cart</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">✅ @TempData["Success"]</div>
    }

    @if (ViewBag.CartItems != null && ViewBag.CartItems.Count > 0)
    {
        <!-- Cart Items -->
        <div class="card shadow-sm mb-4">
            <div class="card-header" style="background: linear-gradient(90deg, #667eea 0%, #764ba2 100%); color: white;">
                <h5 class="mb-0">Your Items</h5>
            </div>
            <div class="card-body">
                @for (int i = 0; i < ViewBag.CartItems.Count; i++)
                {
                    var item = ViewBag.CartItems[i];
                    <div class="cart-item d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="mb-0">@item.Name</h6>
                            <span class="text-muted">₹@item.Price</span>
                        </div>
                        <form method="post" asp-action="RemoveItem" style="display:inline;">
                            <input type="hidden" name="index" value="@i" />
                            <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                        </form>
                    </div>
                }
                <div class="text-end mt-3">
                    <form method="post" asp-action="ClearCart" style="display:inline;">
                        <button type="submit" class="btn btn-outline-danger">Clear Cart</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Promo Code Section -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">🎁 Apply Promo Code</h5>
                <p class="text-muted mb-3">Available: <span class="badge bg-success">WINTER25</span> (15% OFF) | <span class="badge bg-info">FREESHIP</span> ($5 OFF)</p>
                <form method="get" class="row g-3">
                    <div class="col-auto">
                        <input type="text" class="form-control" name="promocode" placeholder="Enter Code" value="@ViewBag.PromoCode" />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">Apply</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Clear</a>
                    </div>
                </form>
            </div>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">❌ @ViewBag.Error</div>
        }
        @if (ViewBag.Applied == true)
        {
            <div class="alert alert-success">✅ Promo Code '@ViewBag.PromoCode' Applied!</div>
        }

        <!-- Cart Summary -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="text-center mb-4">💰 Cart Summary</h5>
                <div class="d-flex justify-content-between mb-2">
                    <span class="fs-5">Subtotal:</span>
                    <span class="fs-5 fw-bold">₹@ViewBag.CartTotal</span>
                </div>
                @if (ViewBag.Applied == true)
                {
                    <div class="d-flex justify-content-between mb-2 text-danger">
                        <span>Discount:</span>
                        <span>- ₹@ViewBag.Discount</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="fs-4 fw-bold">Final Total:</span>
                        <span class="fs-4 fw-bold text-success">₹@ViewBag.FinalTotal</span>
                    </div>
                }
                else
                {
                    <hr />
                    <div class="d-flex justify-content-between">
                        <span class="fs-4 fw-bold">Total:</span>
                        <span class="fs-4 fw-bold">₹@ViewBag.CartTotal</span>
                    </div>
                }
                <button class="btn btn-success btn-lg w-100 mt-4">Proceed to Checkout</button>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm text-center py-5">
            <div class="card-body">
                <h3 class="text-muted mb-4">🛒 Your cart is empty</h3>
                <p class="mb-4">Add some products to get started!</p>
                <a href="@Url.Action("Index", "Products")" class="btn btn-primary btn-lg">Browse Products</a>
            </div>
        </div>
    }
</div>