@model IEnumerable<Vagabond.Web.Models.Destination>

<h2 class="mt-3">Travel Destinations</h2>

<table class="table table-bordered table-striped mt-3">
    <thead class="table-dark">
        <tr>
            <th>City</th>
            <th>Country</th>
            <th>Rating</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CityName</td>
                <td>@item.Country</td>
                <td>@item.Rating</td>

            </tr>
        }
    </tbody>
</table>