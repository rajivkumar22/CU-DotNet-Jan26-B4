<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartBank</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/smartbank-logo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartBank.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid px-4">
                <a class="smartbank-logo navbar-brand" asp-controller="Home" asp-action="Index">
                    <div class="logo-icon">
                        <svg class="logo-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                            <!-- Modern Bank Building Icon -->
                            <defs>
                                <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" style="stop-color:#6a11cb;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#2575fc;stop-opacity:1" />
                                </linearGradient>
                            </defs>
                            <!-- Base building -->
                            <rect x="20" y="65" width="60" height="30" fill="url(#logoGradient)" rx="2"/>
                            <!-- Columns -->
                            <rect x="25" y="35" width="8" height="30" fill="url(#logoGradient)" rx="1"/>
                            <rect x="38" y="35" width="8" height="30" fill="url(#logoGradient)" rx="1"/>
                            <rect x="51" y="35" width="8" height="30" fill="url(#logoGradient)" rx="1"/>
                            <rect x="64" y="35" width="8" height="30" fill="url(#logoGradient)" rx="1"/>
                            <!-- Roof/Triangle -->
                            <path d="M 15 35 L 50 10 L 85 35 Z" fill="url(#logoGradient)"/>
                            <!-- Dollar sign in center -->
                            <text x="50" y="85" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="white" text-anchor="middle">$</text>
                        </svg>
                    </div>
                    <div class="logo-text">
                        <span class="logo-name">SmartBank</span>
                        <span class="logo-tagline">Banking Reimagined</span>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        
                        @if (Context.Session.GetString("JwtToken") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Index">
                                    <i class="bi bi-wallet2 me-1"></i> My Accounts
                                </a>
                            </li>
                        }
                    </ul>
                    
                    <ul class="navbar-nav">
                        @if (Context.Session.GetString("JwtToken") == null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-2" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start">
                    <p class="mb-0">
                        <i class="bi bi-shield-check text-success me-1"></i>
                        &copy; 2026 SmartBank - Secure Banking Solutions
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="me-3">
                        <i class="bi bi-shield-lock me-1"></i>Privacy
                    </a>
                    <a href="#" class="me-3">
                        <i class="bi bi-file-text me-1"></i>Terms
                    </a>
                    <a href="#">
                        <i class="bi bi-headset me-1"></i>Support
                    </a>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
